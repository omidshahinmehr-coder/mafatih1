<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textDirection="rtl"
        android:gravity="center"
        android:layout_marginBottom="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/font_section"
        android:textSize="14sp"
        android:textColor="#888888"
        android:textDirection="rtl" />

    <RadioGroup
        android:id="@+id/fontRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp">

        <RadioButton
            android:id="@+id/fontSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="پیش‌فرض سیستم"
            android:textDirection="rtl"
            android:checked="true" />

        <RadioButton
            android:id="@+id/fontEstedad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استعداد (Estedad)"
            android:textDirection="rtl" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/font_size_section"
        android:textSize="14sp"
        android:textColor="#888888"
        android:textDirection="rtl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp">

        <Button
            android:id="@+id/fontSizeMinus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A-" />

        <TextView
            android:id="@+id/fontSizeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="100%"
            android:textSize="15sp" />

        <Button
            android:id="@+id/fontSizePlus"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A+" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/theme_section"
        android:textSize="14sp"
        android:textColor="#888888"
        android:textDirection="rtl" />

    <RadioGroup
        android:id="@+id/themeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="18dp">

        <RadioButton
            android:id="@+id/themeLight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="روشن"
            android:textDirection="rtl"
            android:checked="true" />

        <RadioButton
            android:id="@+id/themeSepia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="کرم (مطالعه راحت)"
            android:textDirection="rtl" />

        <RadioButton
            android:id="@+id/themeDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تیره"
            android:textDirection="rtl" />

        <RadioButton
            android:id="@+id/themeNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="شب (کم‌نور)"
            android:textDirection="rtl" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translation_section"
        android:textSize="14sp"
        android:textColor="#888888"
        android:textDirection="rtl" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/translationSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="نمایش ترجمه فارسی"
        android:textDirection="rtl"
        android:checked="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"
        android:background="#EEEEEE" />

    <TextView
        android:id="@+id/aboutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_title"
        android:textSize="15sp"
        android:textColor="@color/brand_primary"
        android:textDirection="rtl"
        android:gravity="center"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
</ScrollView>
